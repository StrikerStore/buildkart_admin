{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "BuildKart admin panel — Next.js 16 + React 19 + Tailwind + shadcn/ui.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build && node postbuild.mjs",
    "start": "node start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"**/*.test.ts\"",
    "clean": "rimraf .next .turbo",
    "check:pins": "node scripts/check-pins.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@StrikerStore/contract": "0.5.0",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-image": "3.7.2",
    "@tiptap/extension-link": "3.7.2",
    "@tiptap/react": "3.7.2",
    "@tiptap/starter-kit": "3.7.2",
    "@trpc/client": "11.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
