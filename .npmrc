save-exact=true
engine-strict=true
fund=false
audit=false

# `@StrikerStore/contract` is published from the backend repository to GitHub
# Packages. `NODE_AUTH_TOKEN` must be set in CI and on Railway — a token with
# `read:packages` is enough for this app, which only ever installs it.
@StrikerStore:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
